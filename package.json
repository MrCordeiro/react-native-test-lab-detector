{
  "name": "@pluckd/expo-test-lab-detector",
  "version": "0.1.0",
  "description": "Detect Firebase Test Lab devices, such as the Google Play pre-launch report robots.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:android": "node internal/module_scripts/open-android.js",
    "typecheck": "tsc --noEmit",
    "test:kotlin": "bash scripts/test-kotlin.sh"
  },
  "keywords": [
    "react-native",
    "expo",
    "android",
    "firebase-test-lab",
    "test-lab",
    "google-play",
    "pre-launch-report",
    "robo",
    "analytics"
  ],
  "repository": "https://github.com/MrCordeiro/expo-test-lab-detector",
  "bugs": {
    "url": "https://github.com/MrCordeiro/expo-test-lab-detector/issues"
  },
  "author": "Fernando Cordeiro (https://github.com/MrCordeiro)",
  "license": "MIT",
  "homepage": "https://github.com/MrCordeiro/expo-test-lab-detector#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.22",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^16.1.2",
    "expo": "^58.0.21",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.13",
    "prettier": "^3.0.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "files": [
    "build",
    "src",
    "!src/__tests__",
    "android/build.gradle",
    "android/src/main",
    "expo-module.config.json"
  ],
  "publishConfig": {
    "access": "public"
  }
}
